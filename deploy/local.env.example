# Copy to local.env and edit. local.env is git-ignored. Paths are on the Docker HOST.
DOMAIN="brain.example.com"          # DNS must point to this host; Traefik gets the certificate
VAULT_DIR="/srv/obsidian-vault"     # mounted read-only
STATE_DIR="/srv/brain-mcp-state"    # writable: client registrations + hashed refresh tokens
# APP_DIR="/srv/brain-mcp"          # this repo on the host (default: parent of deploy/)
# RUN_UID=1000                      # uid that can read the vault and write STATE_DIR
# PROJECT="/opt/brain-mcp"          # where docker-compose.yml and .env (password hash) are written
# ALLOW="*"                         # "*" = whole vault, or e.g. "Now.md,Projects,Career"
# DENY=""                           # e.g. "Personal,Finance"
# BRAIN_OWNER="Alex"                # name used in the instructions sent to the AI
# BRAIN_WRITER="their assistant"
# BRAIN_TZ="UTC"                    # IANA zone for note timestamps, e.g. "Asia/Manila"
