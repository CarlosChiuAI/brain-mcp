{
  "name": "brain-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only remote MCP server that shares an Obsidian vault with Claude and other AI apps, behind single-user OAuth 2.1.",
  "author": "Carlos Chiu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarlosChiuAI/brain-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "obsidian",
    "claude",
    "oauth2",
    "read-only"
  ],
  "type": "module",
